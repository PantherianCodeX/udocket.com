{
  "providers": {
    "azure": {
      "display_name": "Azure",
      "description": "Azure AI services hosting OpenAI-compatible deployments in Canadian regions.",
      "category": "platform",
      "hosted_creators": [
        "openai",
        "anthropic",
        "meta",
        "mistral"
      ],
      "env_requirements": [
        "AZURE_OPENAI_ENDPOINT",
        "AZURE_OPENAI_API_KEY"
      ],
      "default_endpoint": "https://<resource>.openai.azure.com",
      "requires_api_key": true,
      "models": {
        "gpt-4o-mini": {
          "label": "GPT-4o Mini",
          "cost_tier": "standard",
          "max_output_tokens": 16384,
          "context_window_tokens": 128000,
          "default_temperature": 1.0,
          "origin": "openai",
          "default_enabled": true
        },
        "gpt-4o": {
          "label": "GPT-4o Premium",
          "cost_tier": "premium",
          "max_output_tokens": 8000,
          "context_window_tokens": 128000,
          "default_temperature": 1.0,
          "origin": "openai",
          "deployment_env": "AZURE_OPENAI_DEPLOYMENT_GPT_4O",
          "default_enabled": true
        },
        "gpt-4.1": {
          "label": "GPT-4.1",
          "cost_tier": "premium",
          "max_output_tokens": 32000,
          "context_window_tokens": 200000,
          "default_temperature": 1.0,
          "origin": "openai",
          "deployment_env": "AZURE_OPENAI_DEPLOYMENT_GPT_4_1",
          "default_enabled": true
        },
        "gpt-5-chat": {
          "label": "GPT-5 Chat",
          "cost_tier": "premium",
          "max_output_tokens": 32000,
          "context_window_tokens": 220000,
          "default_temperature": 1.0,
          "origin": "openai",
          "deployment_env": "AZURE_OPENAI_DEPLOYMENT_GPT_5_CHAT",
          "default_enabled": false
        },
        "gpt-5-mini": {
          "label": "GPT-5 Mini",
          "cost_tier": "standard",
          "max_output_tokens": 16000,
          "context_window_tokens": 200000,
          "default_temperature": 1.0,
          "origin": "openai",
          "deployment_env": "AZURE_OPENAI_DEPLOYMENT_GPT_5_MINI",
          "default_enabled": false
        },
        "gpt-5-nano": {
          "label": "GPT-5 Nano",
          "cost_tier": "economy",
          "max_output_tokens": 8000,
          "context_window_tokens": 128000,
          "default_temperature": 1.0,
          "origin": "openai",
          "deployment_env": "AZURE_OPENAI_DEPLOYMENT_GPT_5_NANO",
          "default_enabled": false
