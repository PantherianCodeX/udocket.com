{
  "providers": {
    "azure": {
      "display_name": "Azure OpenAI (Canada)",
      "env_requirements": [
        "AZURE_OPENAI_ENDPOINT",
        "AZURE_OPENAI_API_KEY"
      ],
      "default_endpoint": "https://<resource>.openai.azure.com",
      "requires_api_key": true,
      "models": {
        "gpt-4o-mini": {
          "label": "GPT-4o Mini",
          "cost_tier": "standard",
          "max_output_tokens": 4000,
          "default_temperature": 0.2
        },
        "gpt-4o": {
          "label": "GPT-4o Premium",
          "cost_tier": "premium",
          "max_output_tokens": 8000,
          "default_temperature": 0.2,
          "deployment_env": "AZURE_OPENAI_DEPLOYMENT_GPT_4O"
        }
      }
    },
    "local": {
      "display_name": "Local Summarizer",
      "description": "Deterministic offline summarizer used for development and fallback.",
      "requires_api_key": false,
      "models": {
        "offline_v1": {
          "label": "Offline Deterministic",
          "cost_tier": "free",
          "max_output_tokens": 2000,
          "default_temperature": 0.0
        }
      }
    },
    "openai": {
      "display_name": "OpenAI",
      "description": "OpenAI platform models such as GPT-4o.",
      "env_requirements": [
        "OPENAI_API_KEY"
      ],
      "default_endpoint": "https://api.openai.com/v1",
      "requires_api_key": true,
      "models": {
        "gpt-4o-mini": {
          "label": "GPT-4o Mini",
          "cost_tier": "standard",
          "max_output_tokens": 4000
        },
        "gpt-4o": {
          "label": "GPT-4o",
          "cost_tier": "premium",
          "max_output_tokens": 8000
        },
        "gpt-4.1": {
          "label": "GPT-4.1",
          "cost_tier": "premium",
          "max_output_tokens": 32000
        }
      }
    },
    "anthropic": {
      "display_name": "Anthropic Claude",
      "description": "Anthropic Claude 3 models via the official API.",
      "env_requirements": [
        "ANTHROPIC_API_KEY"
      ],
      "default_endpoint": "https://api.anthropic.com",
      "requires_api_key": true,
      "models": {
        "claude-3-5-sonnet-latest": {
          "label": "Claude 3.5 Sonnet",
          "cost_tier": "premium",
          "max_output_tokens": 8000
        },
        "claude-3-haiku-20240307": {
          "label": "Claude 3 Haiku",
          "cost_tier": "standard",
          "max_output_tokens": 4000
        }
      }
    },
    "google": {
      "display_name": "Google Gemini",
      "description": "Google Generative AI (Gemini) models via REST API.",
      "env_requirements": [
        "GOOGLE_GENAI_API_KEY"
      ],
      "default_endpoint": "https://generativelanguage.googleapis.com",
      "requires_api_key": true,
      "models": {
        "gemini-1.5-pro": {
          "label": "Gemini 1.5 Pro",
          "cost_tier": "premium",
          "max_output_tokens": 8000
        },
        "gemini-1.5-flash": {
          "label": "Gemini 1.5 Flash",
          "cost_tier": "standard",
          "max_output_tokens": 4000
        }
      }
    },
    "ollama": {
      "display_name": "Ollama (Local)",
      "description": "Self-hosted models served by the local Ollama runtime.",
      "env_requirements": [
        "OLLAMA_BASE_URL"
      ],
      "default_endpoint": "http://127.0.0.1:11434",
      "requires_api_key": false,
      "models": {
        "llama3": {
          "label": "LLaMA 3",
          "cost_tier": "local",
          "max_output_tokens": 4096
        },
        "mistral": {
          "label": "Mistral 7B",
          "cost_tier": "local",
          "max_output_tokens": 4096
        }
