%% Mermaid sequence diagram: LLM failover orchestrator v1
%%{init: {"flowchart": {"htmlLabels": false}, "class": {"htmlLabels": false}, "state": {"htmlLabels": false}, "er": {"htmlLabels": false}, "journey": {"htmlLabels": false}, "timeline": {"htmlLabels": false}}}%%
sequenceDiagram
  participant Worker as "Agent Worker"
  participant Orchestrator as "ModelFailoverOrchestrator"
  participant Registry as "LLM Registry"
  participant Metrics as "Metrics/Audit"

  Worker->>Orchestrator: Request completion (desired model, policy context)
  Orchestrator->>Registry: Fetch model health + fallback chain
  Registry-->>Orchestrator: Primary healthy? {state, evidence_sha256}
  alt Primary healthy
    Orchestrator-->>Worker: Use primary (issue token ceilings)
    Worker-->>Metrics: Record llm_call_count + tokens
  else Primary degraded or OPEN
    Orchestrator->>Metrics: Emit llm_fallback_attempt_total reason=PRIMARY_DEGRADED
    Orchestrator->>Registry: Select next healthy fallback
    Registry-->>Orchestrator: Fallback model details (region, policy posture)
    Orchestrator-->>Worker: Return fallback model assignment
    Worker-->>Metrics: Record fallback call + cost delta
    Orchestrator-->>Registry: Schedule half-open health probes
  end
  Orchestrator->>Metrics: Update llm_circuit_state (OPEN/HALF/CLOSED)
