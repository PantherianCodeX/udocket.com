%% Mermaid sequence diagram: Guardian judgment pipeline v1
sequenceDiagram
  participant Worker as "Agent Worker"
  participant Guardian as "Guardian Service"
  participant OPA as "Policy Engine (OPA)"
  participant Vault as "Masking Vault"
  participant DB as "Postgres (guardian_judgment_history)"
  participant SSE as "SSE / Websocket"

  Worker->>Guardian: Submit artifact (content hash, policy context, waiver?)
  Guardian->>Vault: Apply masking profile to working copy
  Guardian->>OPA: Evaluate policy (residency, masking, waivers)
  OPA-->>Guardian: allow | warn | block (reason codes)
  Guardian->>Gateway: Call provider detectors (vendor hints)
  Guardian->>Guardian: Run first-party detectors (tiers 0–3)
  Guardian->>DB: Upsert `guardian_judgment_history`
  Guardian->>Vault: Persist span metadata & token namespace
  Guardian-->>Worker: PASS | WARN | BLOCK | WAIVED + reasons
  Guardian->>SSE: Emit `guardian.judgment` event
  alt Judgment = BLOCK
    Guardian->>Worker: Keep artifact QUARANTINED
  else Judgment = PASS/WARN
    Guardian->>Worker: Promote WP/CD to CLEARED_FOR_USE | OPERATOR_PREP
  end
