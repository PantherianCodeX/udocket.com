%% Mermaid sequence stub: Upload → Guardian → Approve v1
%%{init: {"flowchart": {"htmlLabels": false}, "class": {"htmlLabels": false}, "state": {"htmlLabels": false}, "er": {"htmlLabels": false}, "journey": {"htmlLabels": false}, "timeline": {"htmlLabels": false}}}%%
sequenceDiagram
  participant U as "User/Client"
  participant Web as "Web (Django)"
  participant Obj as "Object Storage"
  participant DB as "Postgres (RLS)"
  participant G as "Guardian"
  participant R as "Reviewer"
  U->>Web: POST /uploads (create session)
  Web->>Obj: PUT blob (SAS)
  U-->>Obj: Upload file
  U->>Web: POST /uploads/{id}/finalize (Idempotency-Key)
  Web->>DB: INSERT artifact (DRAFT)
  Web->>G: POST /v1/guardian/submit
  G->>DB: UPDATE artifact.state READY or QUARANTINED
  G->>DB: INSERT guardian decision row
  G-->>Web: Return decision payload
  Web-->>U: SSE artifact_state
  R->>Web: POST /reviews/{artifact}/approve (OCC)
  Web->>DB: Demote prior APPROVED deliverable
  Web->>DB: Mark target artifact APPROVED
  Web-->>U: SSE portal_link_invalidated
