%% Mermaid flowchart: Artifact lifecycle overview v1
%%{init: {"flowchart": {"htmlLabels": false}}}%%
flowchart LR
  classDef state fill:#eef2ff,stroke:#312e81,stroke-width:1px,color:#0f172a,rx:10,ry:10;
  classDef link fill:#f8fafc,stroke:#94a3b8,stroke-dasharray:4,color:#475569,rx:8,ry:8;
  classDef decision fill:#fff7ed,stroke:#c2410c,color:#7c2d12,rx:14,ry:14;

  STORED(["SA · STORED"]):::state
  WP_LINK["WP lifecycle<br/>(see detail)"]:::link
  CD_LINK["CD lifecycle<br/>(see detail)"]:::link
  RELEASED(["DL · RELEASED"]):::state
  RETENTION{{Retention / Erasure gate<br/>(policy decision)}}:::decision
  ARCHIVED(["ARCHIVED"]):::state
  DELETED(["DELETED"]):::state

  STORED -->|derive / normalize| WP_LINK
  WP_LINK -->|Guardian PASS / WARN| CD_LINK
  WP_LINK -. retention trigger .-> RETENTION
  CD_LINK -->|Approve + sign| RELEASED
  CD_LINK -. retention trigger .-> RETENTION
  RELEASED -->|replacement / expiry| RETENTION

  RETENTION -->|freeze| ARCHIVED
  RETENTION -->|hard delete| DELETED
