%% analyze-pipeline-v3.mmd
flowchart LR
    classDef stage fill:#f5f5ff,stroke:#445,stroke-width:1.2px,color:#111;
    classDef lane fill:#ecf8ff,stroke:#2684ff,stroke-width:1.1px,color:#111;
    classDef gate fill:#fff8e1,stroke:#b36b00,stroke-width:1.2px,color:#111;
    classDef artifact fill:#e7f6e7,stroke:#2d8a34,stroke-width:1.2px,color:#111;

    Input["Load transcript_v1.json\n+ intake + metadata"]:::stage
    AtomsExtract["Extract atoms"]:::stage
    AtomsIndex["AtomsIndex\n(canonical, citations)"]:::artifact

    subgraph Lanes[Analyze LangGraph Lanes]
        direction TB
        Outline["Outline lane"]:::lane
        Timeline["Timeline lane"]:::lane
        Entities["Entities lane"]:::lane
        Issues["Issues lane"]:::lane
        Gaps["Gaps lane"]:::lane
        Flags["Flags / Alerts lane"]:::lane
    end

    Summary["Summary composer\n(summary_v1.json)"]:::stage
    Staff["Staff report writer\n(staff_report_v1.md)"]:::stage
    QA["QA lane\n(schema + coverage + atom checks)"]:::gate
    Manifest["Write artifacts\n& ops manifests"]:::stage

    Input --> AtomsExtract --> AtomsIndex
    AtomsIndex --> Outline
    AtomsIndex --> Timeline
    AtomsIndex --> Entities
    AtomsIndex --> Issues
    AtomsIndex --> Gaps
    AtomsIndex --> Flags

    Outline --> Summary
    Timeline --> Summary
    Entities --> Summary
    Issues --> Summary
    Gaps --> Summary
    Flags --> Summary

    Summary --> Staff --> QA --> Manifest
    QA -->|Requeue Outline| Outline
    QA -->|Requeue Timeline| Timeline
    QA -->|Requeue Entities| Entities
    QA -->|Requeue Issues| Issues
    QA -->|Requeue Gaps| Gaps
    QA -->|Requeue Flags| Flags
    QA -->|Requeue Summary| Summary

    AtomsExtract -. optional debug .-> AD[(atoms_v1.json)]
