%% compose-pipeline-v1.mmd
flowchart LR
    classDef stage fill:#f5f5ff,stroke:#445,stroke-width:1.2px,color:#111;
    classDef lane fill:#ecf8ff,stroke:#2684ff,stroke-width:1.1px,color:#111;
    classDef gate fill:#fff8e1,stroke:#b36b00,stroke-width:1.2px,color:#111;
    classDef artifact fill:#e7f6e7,stroke:#2d8a34,stroke-width:1.2px,color:#111;

    Context["Assemble ComposeContext\n(summary, timeline, entities, issues, gaps, flags, alerts, intake)"]:::stage

    subgraph ClientLane[Client lane]
        direction TB
        CDraft["Draft client deliverable"]:::lane
        CStruct["Structure guard"]:::gate
        CCompliance["Compliance guard"]:::gate
        CFactual["Factuality guard\n(atom citations)"]:::gate
        CQA["Client QA"]:::gate
    end

    subgraph LawyerLane[Lawyer lane]
        direction TB
        LDraft["Draft lawyer deliverable"]:::lane
        LStruct["Structure guard"]:::gate
        LCompliance["Compliance guard"]:::gate
        LFactual["Factuality guard\n(atom citations)"]:::gate
        LQA["Lawyer QA"]:::gate
    end

    Bundle["Bundle excerpt lane (optional)"]:::lane
    CrossQA["Cross-lane QA\n(bundle, staff, QA reports)"]:::gate
    Finalize["Finalize artifacts\n(versioned outputs + manifests)"]:::stage
    Guardian["Guardian promotion"]:::gate
    Outputs["Deliverables\nMD/DOCX + reports"]:::artifact

    Context --> CDraft --> CStruct --> CCompliance --> CFactual --> CQA --> CrossQA
    Context --> LDraft --> LStruct --> LCompliance --> LFactual --> LQA --> CrossQA
    Context --> Bundle --> CrossQA
    CrossQA --> Finalize --> Guardian --> Outputs

    CStruct -->|Revision| CDraft
    CCompliance -->|Revision| CDraft
    CFactual -->|Revision| CDraft
    CQA -->|Revision| CDraft
    LStruct -->|Revision| LDraft
    LCompliance -->|Revision| LDraft
    LFactual -->|Revision| LDraft
    LQA -->|Revision| LDraft
    CrossQA -->|Revision| CDraft
    CrossQA -->|Revision| LDraft
    CrossQA -->|Revision| Bundle
