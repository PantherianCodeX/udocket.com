%% timeline-pipeline-v1.mmd
%% Future timeline agent pipeline with targeted revisions
flowchart TD
    classDef stage fill:#f5f5ff,stroke:#445,stroke-width:1.2px,color:#111;
    classDef gate fill:#fff8e1,stroke:#b36b00,stroke-width:1.2px,color:#111;
    classDef artifact fill:#e7f6e7,stroke:#2d8a34,stroke-width:1.2px,color:#111;
    classDef directive fill:#f0f4ff,stroke:#3a5bbb,stroke-width:1.2px,color:#111;

    Input["Timeline inputs<br/>(transcript segments + timeline_v1.json)"]:::artifact
    Normalize["Normalize diarised offsets<br/>& merge segments"]:::stage
    Enrich["Enrich events<br/>(atoms, speakers, metadata)"]:::stage
    QA["Timeline QA<br/>(schema + continuity)"]:::gate
    Revision["Revision directives<br/>(event-level instructions)"]:::directive
    Outputs["Analysis artifacts<br/>(timeline_seeds_v1.json, timeline_v2.json)"]:::artifact

    Input --> Normalize --> Enrich --> QA --> Outputs
    QA -->|issue| Revision --> Enrich
