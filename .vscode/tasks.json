{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docs: Render Mermaid (all)",
      "type": "shell",
      "command": "npm run mmd:all",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Docs: Build site (MkDocs)",
      "type": "shell",
      "command": "bash scripts/docs/build_site.sh",
      "problemMatcher": []
    },
    {
      "label": "Docs: Build TDD PDF (Pandoc)",
      "type": "shell",
      "command": "bash scripts/docs/build_pdf_tdd.sh",
      "problemMatcher": []
    },
    {
      "label": "docker: up deps (postgres, redis)",
      "type": "shell",
      "command": "docker compose up -d postgres redis",
      "problemMatcher": []
    },
    {
      "label": "pytest: all (in compose platform)",
      "type": "shell",
      "command": "docker compose run --rm platform pytest -q",
      "dependsOn": [
        "docker: up deps (postgres, redis)"
      ],
      "problemMatcher": []
    },
    {
      "label": "typecheck: mypy (core logging)",
      "type": "shell",
      "command": "mypy packages/core/logging",
      "problemMatcher": []
    },
    {
      "label": "typecheck: pyright (core logging)",
      "type": "shell",
      "command": "pyright packages/core/logging",
      "problemMatcher": []
    },
    {
      "label": "pytest: current file (in compose platform)",
      "type": "shell",
      "command": "docker compose run --rm platform pytest -q /app/${relativeFile}",
      "dependsOn": [
        "docker: up deps (postgres, redis)"
      ],
      "problemMatcher": []
    },
    {
      "label": "pytest: with args (prompt) in compose platform",
      "type": "shell",
      "command": "docker compose run --rm platform pytest ${input:pytestArgs}",
      "dependsOn": [
        "docker: up deps (postgres, redis)"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "pytestArgs",
      "type": "promptString",
      "description": "Additional pytest arguments (e.g. -k pattern tests/ui/test_file.py::TestClass::test_name)",
      "default": "-q"
    }
  ]
}
