AZURE_SPEECH_REGION=canadacentral
#AZURE_SPEECH_ENDPOINT=https://canadacentral.api.cognitive.microsoft.com/
LANGUAGE=en-CA


# Azure Blob Storage (required for true batch mode)
# Option A: account/key
#AZURE_BLOB_ACCOUNT=udocket
#AZURE_BLOB_KEY=sp56AIFkMFUkb3+DiG25qD3DhYRJCP2EArSSisdvmK/1OnDoFr4m31t98JlndR9ZRCnI5oW9CWaX+AStSccYvw==
AZURE_BLOB_ACCOUNT=udocketstore
AZURE_BLOB_KEY=JiwV+WzCnvvzdYRXOWoFvouuHwQug6oCyXbs7wM5zKXF+ryr3obMAG23qJcxBiHC3obDYuVqE4ir+AStc2YVaQ==
# Option B: connection string (overrides account/key if set)
#AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=udocket;AccountKey=sp56AIFkMFUkb3+DiG25qD3DhYRJCP2EArSSisdvmK/1OnDoFr4m31t98JlndR9ZRCnI5oW9CWaX+AStSccYvw==;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER=udocket-audio
AZURE_BLOB_SAS_TTL_MIN=120

# Optional: hash remote audio (Batch mode)
# Set to 1 to stream remote audio and compute SHA256 before transcription.
# Large files are skipped if they exceed BATCH_HASH_MAX_MB.
BATCH_HASH_REMOTE=0
BATCH_HASH_MAX_MB=200

# Paths
# IMPORTANT: inside containers this must be an absolute path matching the bind mount
# in docker-compose (./storage:/app/storage)
STORAGE_ROOT=/app/storage
MAX_UPLOAD_MB=500

# API & Admin
API_BIND=0.0.0.0
API_PORT=8080
ADMIN_BIND=0.0.0.0
ADMIN_PORT=8081

# DB
DATABASE_URL=sqlite:///__AUTO__

# Worker
POLL_INTERVAL_SEC=2
JOB_TIMEOUT_SEC=7200
MAX_CONCURRENT=1

# Agent command template (adjust to your pilot agent CLI)
# placeholders: {audio} {case_id} {case_dir} {outdir} {lang}
AGENT_CMD_TEMPLATE=python packages/udocket_core/agents/transcribe.py --input "{audio}" --case "{case_id}" --outdir "{case_dir}/transcript" --language "{lang}"

# Upload security (comma-separated)
ALLOWED_AUDIO_MIME=audio/wav,audio/x-wav,audio/mpeg,audio/mp4,audio/aac,audio/ogg,audio/flac,audio/x-flac
