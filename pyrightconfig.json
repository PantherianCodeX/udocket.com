{
  "$schema": "https://raw.githubusercontent.com/microsoft/pyright/main/packages/vscode-pyright/schemas/pyrightconfig.schema.json",
  "pythonVersion": "3.12",
  "venvPath": ".",
  "venv": ".venv",
  "typeCheckingMode": "standard",
  // Enable strict via per-file pragma for clean modules only.
  // Keep repo-wide scanning limited initially to core packages.
  "include": [
    "packages",
    "apps/platform/operations"
  ],
  "strict": [
    "packages/ai"
  ],
// STAGE 1
  "reportArgumentType": "warning",
  "reportMissingTypeStubs": "warning",
  "reportAttributeAccessIssue": "warning",
  "reportUnusedImport": "error",
  "reportUnusedVariable": "warning",
  "reportUnusedClass": "warning",
  "reportUnusedFunction": "warning",
  "reportUnnecessaryTypeIgnoreComment": "warning",
  "reportUnnecessaryCast": "warning",
  "reportUnnecessaryIsInstance": "warning",
// // STAGE 2
//   "reportOptionalMemberAccess": "warning",
//   "reportOptionalSubscript": "warning",
//   "reportOptionalCall": "warning",
// // STAGE 3
//   "reportUnknownVariableType": "none",
//   "reportUnknownParameterType": "none",
//   "reportUnknownMemberType": "none",
//   "reportUnknownArgumentType": "none",
//   "reportUnknownLambdaType": "warning",
//   "reportUnknownReturnType": "warning",
  //// stage 4 - API & inheritance correctness
  // "reportIncompatibleVariableOverride": "warning",
  // "reportIncompatibleMethodOverride": "warning",
  // "reportOverlappingOverload": "warning",
  // "reportGeneralTypeIssues": "warning",
  
  "exclude": [
    "**/migrations",
    "**/.venv",
    "**/.tox",
    "**/.pytest_cache",
    "**/__pycache__",
    "apps/platform/accounts",
    "apps/platform/admin",
    "apps/platform/artifacts",
    "apps/platform/authorization",
    "apps/platform/cases",
    "apps/platform/config",
    "apps/platform/jobs",
    "apps/platform/tenancy.py",
    "apps/platform/ui",
    
    "typings/vendor",
    "typings/external_stubs",
    "scripts"
  ],
  "djangoSettingsModule": "apps.platform.config.settings.dev",
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": ["apps", "automation", "services"],
      "venvPath": "opt",
      "venv": "venv"
    },
    {
      "root": "packages/docs_tooling",
      "extraPaths": ["src", ".."],
      "venvPath": "packages/docs_tooling",
      "venv": ".venv"
    },
    {
      "root": "packages/udocket_core",
      "extraPaths": ["src", ".."],
      "venvPath": "packages/udocket_core",
      "venv": ".venv"
    }
  ]
  ,
  "stubPath": "typings"
}
