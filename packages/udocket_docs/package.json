{
  "name": "udocket-docs",
  "private": true,
  "version": "1.0.0",
  "description": "Doc tooling for uDocket diagrams",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "mmd:all": "uv run --project packages/udocket_docs python -m doc_tools.render_mermaid --all --verbose",
    "mmd:changed": "uv run --project packages/udocket_docs python -m doc_tools.render_mermaid --verbose",
    "mmd:paths": "uv run --project packages/udocket_docs python -m doc_tools.render_mermaid --paths"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "markdownlint-cli": "^0.39.0"
  }
}
