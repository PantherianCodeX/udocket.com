  "data": [
    {
      "key": "udocket.case_number.v1/CA-AB-KB",
      "kind": "CASE_NUMBER",
      "court_key": "CA-AB-KB",
      "rules": [
        {
          "pattern": "^(?P<year>\\d{2})(?P<loc>\\d{2})-(?P<seq>\\d{6})$",
          "flags": [],
          "transforms": [ { "op": "TRIM" } ]
        }
      ],
      "constraints": [
        { "kind": "year_range", "group": "year", "min": 0, "max": 99 },
        { "kind": "in_catalog_location_codes", "group": "loc" },
        { "kind": "length", "group": "seq", "min": 6, "max": 6 }
      ],
      "derivations": [
        { "kind": "YEAR_2_TO_4", "src": "year", "century_floor": 1980, "dest": "year4" },
        { "kind": "JOIN", "src": ["year4", "loc", "seq"], "sep": "-", "dest": "normalized" }
      ],
      "examples_valid": ["2301-123456", "9902-000001"],
      "examples_invalid": ["2301-12345", "230-123456", "2399-ABCDEF"]
    },
    {
