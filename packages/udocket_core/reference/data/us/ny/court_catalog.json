{
  "schema": "udocket.reference.catalog.bundle.v1",
  "db": {
    "type": "postgresql",
    "tables": {
      "jurisdictions": {
        "table": "jurisdictions",
        "pk": ["country", "subnational"],
        "unique": [["country", "subnational"]]
      },
      "courts": {
        "table": "courts",
        "pk": ["key"],
        "fk": { "jurisdictions": ["country", "subnational"] },
        "unique": [["country", "subnational", "key"]]
      },
      "court_locations": {
        "table": "court_locations",
        "pk": ["court_key", "slug"],
        "fk": { "courts": ["court_key"] }
      },
      "hearing_codes": {
        "table": "hearing_codes",
        "pk": ["code"]
      },
      "filing_codes": {
        "table": "filing_codes",
        "pk": ["code"]
      },
      "order_codes": {
        "table": "order_codes",
        "pk": ["code"]
      }
    }
  },
