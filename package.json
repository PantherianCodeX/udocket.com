{
  "name": "udocket-docs",
  "private": true,
  "version": "1.0.0",
  "description": "Doc tooling for uDocket diagrams",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
