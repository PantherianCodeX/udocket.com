{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://udocket.ca/schemas/opa/decision_log.schema.json",
  "title": "OPADecisionLog",
  "description": "Normalized decision log entry emitted by OPA sidecars for residency/HIPAA policies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "logged_at",
    "input",
    "result",
    "policy_path"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "logged_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_path": {
      "type": "string",
      "description": "OPA data path evaluated (e.g., data.udocket.residency.allow)."
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "org_id",
        "actor",
        "context_digest"
      ],
      "properties": {
        "org_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "case_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "actor": {
          "type": "string",
          "description": "Service or user that triggered the decision."
        },
        "artifact_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested_region": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_digest": {
          "type": "string",
          "pattern": "^sha256-[A-Fa-f0-9]{64}$"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason_code"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "deny"
          ]
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "OK",
            "REGION_NOT_ALLOWED",
            "WAIVER_REQUIRED",
            "HIPAA_REQUIRED",
            "ATTACHMENT_FORBIDDEN",
            "OPA_ERROR"
          ]
        },
        "policy_block_code": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "POLICY_BLOCK",
            "RESIDENCY_POLICY_BLOCK",
            "HIPAA_REQUIRED",
            "ATTACHMENT_BLOCK"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      }
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    }
  }
}
