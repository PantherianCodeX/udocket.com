{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://udocket.ca/schemas/opa/discovery_manifest.schema.json",
  "title": "OPADiscoveryManifest",
  "description": "Manifest used by OPA evaluators to discover policy/data bundles published by the platform.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issued_at",
    "channels"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "bundle_uri",
          "sha256",
          "etag",
          "regions",
          "bundle_type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "stable",
              "beta",
              "canary"
            ]
          },
          "bundle_uri": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "etag": {
            "type": "string",
            "maxLength": 128
          },
          "bundle_type": {
            "type": "string",
            "enum": [
              "rego",
              "data"
            ]
          },
          "regions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "rollout": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start_at": {
                "type": "string",
                "format": "date-time"
              },
              "end_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "min_ready_percent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "promotion_rules": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "promotes_to": {
                "type": "string",
                "enum": [
                  "stable",
                  "beta"
                ]
              },
              "required_observations_minutes": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "cache_ttl_seconds": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
