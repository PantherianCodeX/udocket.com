{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://udocket.ca/schemas/log_record.schema.json",
  "title": "LogRecord@1",
  "description": "Canonical structured logging schema for platform services (stream: stdout).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ts",
    "level",
    "service",
    "src",
    "message",
    "trace_id",
    "span_id"
  ],
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "level": {
      "type": "string",
      "enum": [
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ]
    },
    "service": {
      "type": "string"
    },
    "src": {
      "type": "string",
      "description": "Compact source location (module:function:line)."
    },
    "message": {
      "type": "string",
      "maxLength": 160
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{32}$"
    },
    "span_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{16}$"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "org_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "case_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "job_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "artifact_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "action": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": [
        "string",
        "null"
      ]
    },
    "latency_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "extras": {
      "type": "object",
      "description": "Structured diagnostic payloads. Keys must be vetted to avoid PII.",
      "additionalProperties": true
    },
    "stream": {
      "type": "string",
      "enum": [
        "stdout",
        "stderr"
      ],
      "default": "stdout"
    }
  }
}
