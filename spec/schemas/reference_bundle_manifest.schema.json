{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://udocket.ca/schemas/reference_bundle_manifest.schema.json",
  "title": "ReferenceBundleManifest",
  "description": "Signed manifest that describes a Reference Manager bundle release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domain",
    "version",
    "effective_at",
    "hash_sha256",
    "artifacts",
    "source_provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Manifest schema version (semver)."
    },
    "domain": {
      "type": "string",
      "enum": [
        "courts",
        "localization",
        "policy",
        "questionnaires",
        "forms",
        "resources",
        "opa"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-rc\\.[0-9]+)?$"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "hash_sha256": {
      "type": "string",
      "pattern": "^sha256-[A-Fa-f0-9]{64}$",
      "description": "Digest of the canonical bundle payload."
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "signature"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "ed25519"
          ]
        },
        "signature": {
          "type": "string",
          "description": "Base64-url encoded signature."
        },
        "key_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Identifier of the signing key."
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_version": {
          "type": "string"
        },
        "max_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "uri",
          "hash_sha256",
          "content_type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "hash_sha256": {
            "type": "string",
            "pattern": "^sha256-[A-Fa-f0-9]{64}$"
          },
          "content_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "source_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "license",
          "terms"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "terms": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 2048
    }
  }
}
