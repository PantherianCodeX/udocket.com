{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://udocket.ca/schemas/policy_context.schema.json",
  "title": "PolicyContextEnvelope",
  "description": "Deterministic policy context returned by the Localization & Policy Engine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_context_version",
    "generated_at",
    "digest_sha256",
    "data"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Semantic version of this schema (aligned with policy_context.schema.json releases)."
    },
    "policy_context_version": {
      "type": "string",
      "description": "Monotonic identifier for the compiled context."
    },
    "source_settings_version": {
      "type": "string",
      "description": "Settings bundle version used when compiling the context."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp the context was generated (UTC)."
    },
    "digest_sha256": {
      "type": "string",
      "pattern": "^sha256-[A-Fa-f0-9]{64}$",
      "description": "Content digest of the canonicalized context payload."
    },
    "data": {
      "$ref": "#/$defs/context"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "bcp47": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "org_id",
        "locale",
        "privacy_flags",
        "frameworks",
        "residency_regions",
        "portal_rules",
        "masking_profile"
      ],
      "properties": {
        "org_id": {
          "$ref": "#/$defs/uuid"
        },
        "case_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "locale": {
          "$ref": "#/$defs/bcp47"
        },
        "privacy_flags": {
          "type": "object",
          "description": "Sorted key/value pairs that influence HIPAA/PHI posture.",
          "additionalProperties": {
            "type": [
              "boolean",
              "string",
              "number"
            ]
          }
        },
        "frameworks": {
          "type": "object",
          "required": [
            "enabled",
            "hipaa_required"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "hipaa_required": {
              "type": "boolean"
            },
            "hipaa_enabled": {
              "type": "boolean"
            }
          }
        },
        "residency_regions": {
          "type": "object",
          "required": [
            "compute",
            "storage",
            "vector"
          ],
          "additionalProperties": false,
          "properties": {
            "compute": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "storage": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "vector": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "retention_days": {
          "type": "object",
          "description": "Retention periods by artifact class.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "portal_rules": {
          "type": "object",
          "required": [
            "disclaimer_key"
          ],
          "additionalProperties": false,
          "properties": {
            "disclaimer_key": {
              "type": "string"
            },
            "banner_key": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "logging_rules": {
          "type": "object",
          "description": "Optional logging/telemetry hints (masking etc.).",
          "additionalProperties": true
        },
        "masking_profile": {
          "type": "string"
        },
        "i18n_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
