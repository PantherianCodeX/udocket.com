{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://udocket.ca/schemas/api_error.schema.json",
  "title": "ApiError",
  "description": "Canonical envelope returned for platform HTTP errors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message",
    "correlation_id"
  ],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "POLICY_BLOCK",
        "QUARANTINED",
        "INTEGRITY_ERROR",
        "VALIDATION_ERROR",
        "AUTH_ERROR",
        "NOT_FOUND",
        "CONFLICT",
        "RATE_LIMIT",
        "PROVIDER_DEGRADED"
      ]
    },
    "message": {
      "type": "string",
      "description": "Human-readable explanation suitable for operators."
    },
    "details": {
      "type": [
        "object",
        "null"
      ],
      "description": "Machine-readable context; schema varies by error code."
    },
    "correlation_id": {
      "type": "string",
      "description": "Trace or request identifier echoed to clients."
    }
  }
}
