{
  "name": "uDocket Platform Dev",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../docker-compose.override.yml",
    "docker-compose.devcontainer.yml"
  ],
  "service": "platform-dev",
  "runServices": [
    "postgres",
    "redis",
    "platform-dev"
  ],
  "shutdownAction": "stopCompose",
  "workspaceFolder": "/app",
  "overrideCommand": true,
  "remoteUser": "root",
  "remoteEnv": {
    "DJANGO_SETTINGS_MODULE": "apps.platform.config.settings.dev",
    "ENV_READ_DOTENV": "1"
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -r apps/platform/requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "ms-python.black-formatter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "python.testing.pytestPath": "/usr/local/bin/pytest"
      }
    }
  }
}

