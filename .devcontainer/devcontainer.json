{
  "name": "uDocket Platform Dev",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../docker-compose.override.yml",
    "./docker-compose.devcontainer.yml"
  ],
  "service": "platform-dev",
  "runServices": [
    "platform-dev"
  ],
  "shutdownAction": "stopCompose",
  "workspaceFolder": "/app",
  "overrideCommand": true,
  "remoteUser": "root",
  "remoteEnv": {
    "DJANGO_SETTINGS_MODULE": "apps.platform.config.settings.dev",
    "ENV_READ_DOTENV": "1"
  },
  "postCreateCommand": "bash -lc 'set -euo pipefail; ./scripts/setup_buildx_cache.sh; if [ \"${INSTALL_DOCS:-1}\" = \"1\" ]; then pip install -r requirements-docs.txt; fi; npm ci; python scripts/typing/vendor_stubs.py'",
  "customizations": {
    "vscode": {
      "extensions": [
        "etmoffat.pip-packages",
        "github.copilot",
        "github.copilot-chat",
        "github.vscode-pull-request-github",
        "ms-azuretools.vscode-containers",
        "ms-azuretools.vscode-docker",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        "ms-python.debugpy",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",
        "ms-vscode-remote.remote-containers",
        "openai.chatgpt",
        "slightc.pip-manager",
        "ms-python.mypy-type-checker",
        "yzhang.markdown-all-in-one",
        "DavidAnson.vscode-markdownlint",
        "bierner.markdown-preview-github-styles",
        "tomoki1207.pdf",
        "ms-vscode.vscode-node-azure-pack",
        "ms-windows-ai-studio.windows-ai-studio",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "firefox-devtools.vscode-firefox-debug",
        "ms-azuretools.vscode-azurevirtualmachines",
        "Azurite.azurite"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/app/.venv/bin/python"
      }
    }
  }
}
