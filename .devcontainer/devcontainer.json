{
  "name": "uDocket Platform Dev",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../docker-compose.dev.yml",
    "../docker-compose.cache.yml",
    "./docker-compose.devcontainer.yml"
  ],
  "service": "platform-dev",
  "runServices": [
    "platform-dev"
  ],
  "initializeCommand": "bash -lc './scripts/devcontainer/ensure_buildx_builder.sh'",
  "shutdownAction": "stopCompose",
  "workspaceFolder": "/udocket",
  "forwardPorts": [8000, 8010],
  "overrideCommand": true,
  "remoteUser": "root",
  "remoteEnv": {
    "DJANGO_SETTINGS_MODULE": "apps.platform.config.settings.dev",
    "ENV_READ_DOTENV": "1"
  },
  "containerEnv": {
    "HOST_REPO_ROOT": "${localWorkspaceFolder}",
    "UV_PROJECT_ENVIRONMENT": "/udocket/.venv",
    "VIRTUAL_ENV": "/udocket/.venv"
    // "PATH": "/udocket/.venv/bin:${PATH}"
  },
  "postCreateCommand": "bash -lc './scripts/devcontainer/post_create.sh'",
  "postStartCommand": "bash -lc '[ -d /udocket/.venv ] || ./scripts/devcontainer/post_create.sh'",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/udocket/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "args": ["-l"],
            "icon": "terminal-bash"
          }
        }
      },
      "extensions": [
        "ms-azuretools.vscode-containers",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-python.debugpy",
        "etmoffat.pip-packages",
        "slightc.pip-manager",
        "ms-python.vscode-python-envs",
        "ms-python.vscode-pylance",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "DavidAnson.vscode-markdownlint",
        "github.vscode-pull-request-github",
        "donjayamanne.githistory",
        "ms-vscode-remote.remote-containers",
        "yzhang.markdown-all-in-one",
        "bierner.markdown-preview-github-styles",
        "tomoki1207.pdf",
        "openai.chatgpt",
        "ms-vscode.vscode-node-azure-pack",
        "ms-windows-ai-studio.windows-ai-studio",
        "firefox-devtools.vscode-firefox-debug",
        "ms-azuretools.vscode-azurevirtualmachines",
        "Azurite.azurite"
      ]
    }
  }
}
