#########################################
# Core Platform (Django + DRF + Channels)
#########################################

# Django
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
DJANGO_LANGUAGE_CODE=en-ca
DJANGO_TIME_ZONE=UTC
# Local bootstrap (development only)
PLATFORM_BOOTSTRAP_ENABLED=1
# PLATFORM_BOOTSTRAP_CONFIG=./config/bootstrap_defaults.json
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=changeme
DJANGO_SUPERUSER_EMAIL=admin@example.com
PLATFORM_BOOTSTRAP_SUPERUSER_RESET_PASSWORD=1
PLATFORM_BOOTSTRAP_ORG_NAME="Demo Organization"
PLATFORM_BOOTSTRAP_ORG_DISPLAY_NAME="Demo Organization"
PLATFORM_BOOTSTRAP_ORG_CONTACT_EMAIL=demo@example.com
PLATFORM_BOOTSTRAP_ATTACH_SUPERUSER=1
PLATFORM_BOOTSTRAP_IMPORT_PRESETS=1

# Storage paths
STORAGE_ROOT=/app/storage
MEDIA_ROOT=/app/storage/media
COURT_CATALOG_ROOT=/app/packages/udocket_core/reference/court_catalogs

# Database (Postgres recommended for multi-tenant security)
DATABASE_URL=postgresql://platform:platformpass@postgres:5432/udocket
POSTGRES_DB=udocket
POSTGRES_USER=platform
POSTGRES_PASSWORD=platformpass
POSTGRES_PORT=5432

# Redis / Celery / Channels
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=django-db
CELERY_WORKER_FLAGS=-E

# Security defaults (dev-safe)
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
CSRF_TRUSTED_ORIGINS=
SECURE_HSTS_SECONDS=0

# Logging
DJANGO_LOG_LEVEL=INFO
PLATFORM_LOG_LEVEL=DEBUG
AZURE_LOG_LEVEL=warning
CELERY_LOG_LEVEL=debug
CELERY_WORKER_FLAGS=-E
LANGGRAPH_DEBUG=1 
LANGCHAIN_LOG_LEVEL=info
DJANGO_AUTH_LOG_LEVEL=INFO
AUTH_LOG_LEVEL=INFO

# Dev-open toggle (allows anonymous in dev contexts)
PLATFORM_DEV_OPEN=1
SECURE_SSL_REDIRECT=0
ENV_READ_DOTENV=1

#########################################
# IAM / Auth (Keycloak)
#########################################

# API JWT (optional; set to enable Bearer token auth)
OIDC_JWKS_URL=
OIDC_ISSUER=http://localhost:8085/realms/udocket
OIDC_AUDIENCE=

# Browser SSO (optional; set to enable OIDC login)
OIDC_DISCOVERY_URL=http://localhost:8085/realms/udocket/.well-known/openid-configuration
# Optional overrides for internal service access vs. browser redirects
# OIDC_OP_AUTHORIZATION_ENDPOINT=http://localhost:8085/realms/udocket/protocol/openid-connect/auth
# OIDC_OP_TOKEN_ENDPOINT=http://keycloak:8085/realms/udocket/protocol/openid-connect/token
# OIDC_OP_USER_ENDPOINT=http://keycloak:8085/realms/udocket/protocol/openid-connect/userinfo
# OIDC_OP_JWKS_ENDPOINT=http://keycloak:8085/realms/udocket/protocol/openid-connect/certs
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional: sync CaseMembership from Keycloak group claims
# Groups formatted as: case:<CASE_ID>:<ROLE>
OIDC_SYNC_MEMBERSHIPS=0
OIDC_CASE_GROUP_PREFIX=case:
OIDC_CASE_GROUP_SEPARATOR=:
OIDC_CASE_DEFAULT_ROLE=REVIEWER

# Keycloak admin bootstrap (used by container)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
# Local dev: docker-compose sets Keycloak hostname to http://localhost:8085
# (KC_HOSTNAME_URL/KC_HOSTNAME_STRICT) so browser redirects stay reachable.

# Optional: header used to select active organization for RLS
ORG_HEADER_NAME=HTTP_X_ORGANIZATION_ID

#########################################
# Agent (Transcription) Configuration
#########################################

# Azure Speech (Canada-only regions)
AZURE_SPEECH_KEY=__FILL_ME__
AZURE_SPEECH_REGION=canadacentral
LANGUAGE=en-CA

# Azure Blob Storage (required for true batch mode)
# Option A: account/key
AZURE_BLOB_ACCOUNT=
AZURE_BLOB_KEY=
# Option B: connection string (overrides account/key if set)
# AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=udocket-audio
AZURE_BLOB_SAS_TTL_MIN=120

# End-to-end transcription tests (set to 1 when running pytest -m e2e_transcribe)
# E2E_TRANSCRIBE=0
# On-demand not working - may deprecate completely
# E2E_TRANSCRIBE_ONDEMAND=1

# Optional: hash remote audio (Batch mode)
# Set to 1 to stream remote audio and compute SHA256 before transcription.
# Large files are skipped if they exceed BATCH_HASH_MAX_MB.
BATCH_HASH_REMOTE=0
BATCH_HASH_MAX_MB=200

# Upload limits
MAX_UPLOAD_MB=500

#########################################
# Agent (Analyze) Configuration
#########################################

# Azure OpenAI (Canada regions only)
# Set these to enable Azure-hosted summarization when Azure is the selected provider.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Dev-only override: set to 1 to allow non-Canadian Azure regions (never enable in production).
AZURE_OPENAI_ALLOW_NON_CA_REGION=0
# Tuned Azure client resilience for long requests
# Granular timeouts: connect timeout (sec) and read timeout (sec)
AZURE_OPENAI_CONNECT_TIMEOUT=15
AZURE_OPENAI_READ_TIMEOUT=900
# Fallback overall timeout (used if granular not set)
AZURE_OPENAI_TIMEOUT=180
# Retry tuning
AZURE_OPENAI_RETRY_TOTAL=5
AZURE_OPENAI_RETRY_BACKOFF_FACTOR=1.2
# Session pool size
AZURE_OPENAI_SESSION_POOL_SIZE=20
# Optional: deployment names for specific Azure models (used if set)
AZURE_OPENAI_DEPLOYMENT_GPT_4O=
AZURE_OPENAI_DEPLOYMENT_GPT_4_1=
AZURE_OPENAI_DEPLOYMENT_GPT_5_CHAT=
AZURE_OPENAI_DEPLOYMENT_GPT_5_MINI=
AZURE_OPENAI_DEPLOYMENT_GPT_5_NANO=

# Runtime defaults (temperature, prompt limits, provider order) are defined in
# `config/analyze_defaults.json` and should be updated there instead of here.

# Development-only controls
# Provider configuration (order defines priority).

# Additional LLM provider credentials (optional)
OPENAI_API_KEY=
OPENAI_API_ENDPOINT=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GOOGLE_GENAI_API_KEY=
GOOGLE_GENAI_ENDPOINT=https://generativelanguage.googleapis.com
OLLAMA_BASE_URL=http://127.0.0.1:11434

#########################################
# Agent (Compose) Configuration
#########################################

# Provider chain (comma-separated). Defaults to "azure" when unset.
COMPOSE_PROVIDER_CHAIN=azure

# Temperature controls for client and lawyer composers.
COMPOSE_TEMPERATURE=0.6
COMPOSE_LAWYER_TEMPERATURE=0.4

# Maximum tokens the Compose agent will request from the LLM.
COMPOSE_MAX_OUTPUT_TOKENS=12000

# Retry limits per lane (draft + revision loops).
COMPOSE_MAX_CLIENT_ATTEMPTS=2
COMPOSE_MAX_LAWYER_ATTEMPTS=2

# Minimum timestamp references required when drafting context (used by QA/factuality gates).
COMPOSE_MIN_TIMESTAMP_REFERENCES=3

# Toggle QA gating (set to 0 to allow QA to passively log without blocking release).
COMPOSE_QA_ENFORCED=1

# Allow the optional editor lane to run when QA requests targeted edits.
COMPOSE_ENABLE_EDITOR=1

# Maximum number of QA review cycles before failing the job.
COMPOSE_QA_MAX_ITERATIONS=3

# LLM retry behaviour (applies to transient errors at the Chat API layer).
COMPOSE_LLM_RETRY_ATTEMPTS=2
COMPOSE_LLM_RETRY_DELAY_SECONDS=2.0

# Enable async orchestration (parallel client/lawyer lanes with LangGraph).
COMPOSE_ENABLE_ASYNC=1

# Optional: override editor models per lane.
# COMPOSE_CLIENT_EDITOR_MODEL=gpt-4o-mini
# COMPOSE_LAWYER_EDITOR_MODEL=gpt-4o-mini

# Optional: absolute path to a DOCX template used when rendering deliverables.
# COMPOSE_DOCX_TEMPLATE=/app/config/templates/compose_template.docx
