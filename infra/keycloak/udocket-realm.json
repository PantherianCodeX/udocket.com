{
  "realm": "udocket",
  "enabled": true,
  "users": [],
  "groups": [
    {
      "name": "udocket-admin"
    }
  ],
  "clients": [
    {
      "clientId": "udocket-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": [
        "http://localhost:8000/oidc/callback/*",
        "http://localhost:8000/oidc/callback/"
      ],
      "webOrigins": [
        "*"
      ],
      "defaultClientScopes": [
        "openid",
        "email",
        "profile",
        "organizations",
        "case-memberships"
      ],
      "optionalClientScopes": [
        "roles"
      ]
    },
    {
      "clientId": "udocket-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "redirectUris": [
        "http://localhost:8000/oidc/callback/*",
        "http://localhost:8000/oidc/callback/"
      ],
      "webOrigins": [
        "*"
      ],
      "defaultClientScopes": [
        "openid",
        "email",
        "profile",
        "organizations",
        "case-memberships"
      ],
      "optionalClientScopes": [
        "roles"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "openid",
      "protocol": "openid-connect"
    },
    {
      "name": "email",
      "protocol": "openid-connect"
    },
    {
      "name": "profile",
      "protocol": "openid-connect"
    },
    {
      "name": "organizations",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": true
      }
    },
    {
      "name": "roles",
      "protocol": "openid-connect"
    },
    {
      "name": "case-memberships",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": true
      },
      "protocolMappers": [
        {
          "name": "Case Memberships",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "case_memberships",
            "claim.name": "case_memberships",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
