FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
WORKDIR /app
COPY . /app
RUN pip install -r apps/admin/requirements.txt
EXPOSE 8081
CMD ["uvicorn", "apps.admin.app.main:app", "--host", "0.0.0.0", "--port", "8081", "--workers", "1", "--log-config", "infra/logging/uvicorn.yml"]
