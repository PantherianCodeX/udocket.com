{
  "realm": "udocket",
  "enabled": true,
  "users": [],
  "groups": [
    {"name": "udocket-admin"}
  ],
  "clients": [
    {
      "clientId": "udocket-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": [
        "http://localhost:8000/oidc/callback/*",
        "http://localhost:8000/oidc/callback/"
      ],
      "webOrigins": ["*"] ,
      "defaultClientScopes": ["openid", "email", "profile"],
      "optionalClientScopes": ["roles"]
    },
    {
      "clientId": "udocket-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "redirectUris": [
        "http://localhost:8000/oidc/callback/*",
        "http://localhost:8000/oidc/callback/"
      ],
      "webOrigins": ["*"] ,
      "defaultClientScopes": ["openid", "email", "profile", "groups-scope"],
      "optionalClientScopes": ["roles"]
    }
  ],
  "clientScopes": [
    {"name": "openid", "protocol": "openid-connect"},
    {"name": "email", "protocol": "openid-connect"},
    {"name": "profile", "protocol": "openid-connect"},
    {"name": "roles", "protocol": "openid-connect"},
    {
      "name": "groups-scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": true
      },
      "protocolMappers": [
        {
          "name": "Group Membership",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        },
        {
          "name": "Preferred Username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "Email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
