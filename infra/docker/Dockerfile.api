FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
WORKDIR /app
COPY . /app
RUN pip install -r apps/api/requirements.txt
EXPOSE 8080
CMD ["uvicorn", "apps.api.app.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--log-config", "infra/logging/uvicorn.yml"]
