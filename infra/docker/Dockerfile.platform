# syntax=docker/dockerfile:1.7-labs

# Allow overriding the Python base image (useful for mirrors/registries)
ARG PYTHON_BASE=python:3.12-slim-bookworm
ARG DEV_TOOLS=0

FROM ${PYTHON_BASE} AS python-base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive
    
# Core packages needed for every image
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg \
      ca-certificates \
      curl \
      git

# Keep pip modern once so every downstream stage benefits.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade pip

# Install uv once so downstream stages share the same toolchain.
RUN --mount=type=cache,target=/root/.cache/uv-installer,sharing=locked <<'EOF'
set -eux
cache_dir="/root/.cache/uv-installer"
mkdir -p "$cache_dir"
script="$cache_dir/install.sh"
if [ ! -f "$script" ]; then
  curl -fsSL https://astral.sh/uv/install.sh -o "$script"
fi
UV_INSTALL_DIR=/usr/local/bin sh "$script"
EOF

FROM python-base AS toolchain
ARG DEV_TOOLS

# Optional developer tooling (docker CLI, debugging helpers, etc.)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,target=/tmp/cache-downloads,sharing=locked \
    if [ "$DEV_TOOLS" = "1" ]; then \
      set -eux; \
      install -m 0755 -d /etc/apt/keyrings; \
      cache_dir="/tmp/cache-downloads"; \
      docker_key="$cache_dir/docker.gpg"; \
      gh_key="$cache_dir/gh.gpg"; \
      if [ ! -f "$docker_key" ]; then curl -fsSL https://download.docker.com/linux/debian/gpg -o "$docker_key"; fi; \
      cp "$docker_key" /etc/apt/keyrings/docker.asc; \
      chmod a+r /etc/apt/keyrings/docker.asc; \
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list; \
      if [ ! -f "$gh_key" ]; then curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o "$gh_key"; fi; \
      cp "$gh_key" /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
      chmod a+r /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list; \
      apt-get update; \
      apt-get install -y --no-install-recommends \
        build-essential gcc g++ pkg-config libpq-dev \
        git-lfs htop iputils-ping jq less lsof nano ripgrep strace tree unzip vim-tiny wget netcat-openbsd \
        postgresql-client-15 \
        docker-ce-cli docker-buildx-plugin docker-compose-plugin \
        gh \
      ; \
      git lfs install --system; \
    fi;

FROM toolchain AS python-deps
ARG DEV_TOOLS

WORKDIR /app

COPY apps/platform/pyproject.toml apps/platform/uv.lock /app/apps/platform/

RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv sync --frozen --no-dev --no-install-project --project apps/platform \
 && if [ "$DEV_TOOLS" = "1" ]; then uv sync --frozen --only-group dev --no-install-project --project apps/platform; fi

FROM python-deps AS app

WORKDIR /app

COPY --from=python-deps /app/apps/platform/.venv /app/apps/platform/.venv

# Copy project source last to keep dependency layers hot
COPY . /app

ENV VIRTUAL_ENV=/app/apps/platform/.venv
ENV PATH="/app/apps/platform/.venv/bin:${PATH}"

EXPOSE 8000

# Default to prod settings; override in compose if needed
ENV DJANGO_SETTINGS_MODULE=apps.platform.config.settings.prod

COPY infra/docker/entrypoint.platform.sh /usr/local/bin/platform-entrypoint.sh
RUN chmod +x /usr/local/bin/platform-entrypoint.sh

ENTRYPOINT ["platform-entrypoint.sh"]
CMD ["daphne", "-b", "0.0.0.0", "-p", "8000", "apps.platform.config.asgi:application"]
