# syntax=docker/dockerfile:1.7-labs

# Allow overriding the Python base image (useful for mirrors/registries)
ARG PYTHON_BASE=python:3.12-slim-bookworm
ARG DEV_TOOLS=0

FROM ${PYTHON_BASE} AS python-base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# Core packages needed for every image
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg \
      ca-certificates \
      curl \
      git \
 && rm -rf /var/lib/apt/lists/*

# Keep pip modern once so every downstream stage benefits.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade pip

FROM python-base AS toolchain
ARG DEV_TOOLS

# Optional developer tooling (docker CLI, browsers, etc.)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    if [ "$DEV_TOOLS" = "1" ]; then \
      set -eux; \
      install -m 0755 -d /etc/apt/keyrings; \
      curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc; \
      chmod a+r /etc/apt/keyrings/docker.asc; \
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list; \
      apt-get update; \
      apt-get install -y --no-install-recommends \
        build-essential gcc g++ pkg-config libpq-dev \
        git-lfs htop iputils-ping jq less lsof nano ripgrep strace tree unzip vim-tiny wget netcat-openbsd \
        postgresql-client \
        docker-ce-cli docker-buildx-plugin docker-compose-plugin \
        nodejs npm \
        fonts-liberation libasound2 libatk-bridge2.0-0 libatk1.0-0 \
        libcairo2 libcups2 libdbus-1-3 libexpat1 libfontconfig1 libgbm1 \
        libglib2.0-0 libgtk-3-0 libnspr4 libnss3 libpango-1.0-0 libpangocairo-1.0-0 \
        libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxcursor1 libxdamage1 \
        libxext6 libxfixes3 libxi6 libxrandr2 libxrender1 libxss1 libxtst6 xdg-utils \
        pandoc \
      ; \
      git lfs install --system; \
      rm -rf /var/lib/apt/lists/*; \
    fi

FROM toolchain AS runtime-wheels

WORKDIR /tmp/pip

COPY apps/platform/requirements.txt runtime.txt
COPY packages/udocket_core/requirements.txt core.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    mkdir -p /wheels \
 && pip wheel --wheel-dir /wheels wheel \
 && pip wheel --wheel-dir /wheels --requirement runtime.txt \
 && pip wheel --wheel-dir /wheels --requirement core.txt

FROM runtime-wheels AS dev-wheels
ARG DEV_TOOLS

COPY apps/platform/requirements-dev.txt dev.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    if [ "$DEV_TOOLS" = "1" ]; then \
      pip wheel --wheel-dir /wheels --requirement dev.txt; \
    fi

FROM toolchain AS python-deps
ARG DEV_TOOLS

WORKDIR /app

COPY --from=dev-wheels /wheels /tmp/wheels

# Install Python dependencies (shared across services)
COPY apps/platform/requirements.txt /tmp/platform-requirements.txt
COPY apps/platform/requirements-dev.txt /tmp/platform-requirements-dev.txt
COPY packages/udocket_core/requirements.txt /tmp/udocket-core-requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-index --find-links=/tmp/wheels -r /tmp/platform-requirements.txt \
 && pip install --no-index --find-links=/tmp/wheels -r /tmp/udocket-core-requirements.txt \
 && if [ "$DEV_TOOLS" = "1" ]; then pip install --no-index --find-links=/tmp/wheels -r /tmp/platform-requirements-dev.txt; fi \
 && rm -f /tmp/platform-requirements.txt /tmp/platform-requirements-dev.txt /tmp/udocket-core-requirements.txt \
 && rm -rf /tmp/wheels

FROM python-deps AS app

WORKDIR /app

# Copy project source last to keep dependency layers hot
COPY . /app

EXPOSE 8000

# Default to prod settings; override in compose if needed
ENV DJANGO_SETTINGS_MODULE=apps.platform.config.settings.prod

COPY infra/docker/entrypoint.platform.sh /usr/local/bin/platform-entrypoint.sh
RUN chmod +x /usr/local/bin/platform-entrypoint.sh

ENTRYPOINT ["platform-entrypoint.sh"]
CMD ["daphne", "-b", "0.0.0.0", "-p", "8000", "apps.platform.config.asgi:application"]
