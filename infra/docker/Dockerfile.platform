# syntax=docker/dockerfile:1.7-labs

# Allow overriding the Python base image (useful for mirrors/registries)
ARG PYTHON_BASE=python:3.12-slim-bookworm
ARG DEV_TOOLS=0

FROM ${PYTHON_BASE} AS python-base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive
    
# Core packages needed for every image
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg \
      ca-certificates \
      curl \
      git \
 && rm -rf /var/lib/apt/lists/*

# Keep pip modern once so every downstream stage benefits.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade pip

FROM python-base AS toolchain
ARG DEV_TOOLS
ARG VALE_VERSION=3.7.1
ARG PLAYWRIGHT_VERSION=1.46.0
ARG NPM_VERSION=11.6.2

# Optional developer tooling (docker CLI, browsers, etc.)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,target=/root/.npm,sharing=locked \
    if [ "$DEV_TOOLS" = "1" ]; then \
      set -eux; \
      install -m 0755 -d /etc/apt/keyrings; \
      curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc; \
      chmod a+r /etc/apt/keyrings/docker.asc; \
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list; \
      curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
      chmod a+r /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list; \
      curl -fsSL https://deb.nodesource.com/setup_22.x -o /tmp/nodesource.sh; \
      bash /tmp/nodesource.sh; \
      rm -f /tmp/nodesource.sh; \
      apt-get update; \
      apt-get install -y --no-install-recommends \
        build-essential gcc g++ pkg-config libpq-dev \
        git-lfs htop iputils-ping jq less lsof nano ripgrep strace tree unzip vim-tiny wget netcat-openbsd \
        postgresql-client-15 \
        docker-ce-cli docker-buildx-plugin docker-compose-plugin \
        gh \
        nodejs \
        pandoc \
      ; \
    fi;
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,target=/root/.npm,sharing=locked \
    if [ "$DEV_TOOLS" = "1" ]; then \
      npm install -g "npm@${NPM_VERSION}"; \
      npx --yes "playwright@${PLAYWRIGHT_VERSION}" install-deps; \
      ARCH="$(dpkg --print-architecture)"; \
      case "$ARCH" in \
        amd64) VALE_ASSET_REGEX='Linux_64-bit.*tar\.gz$' ;; \
        arm64) VALE_ASSET_REGEX='Linux_arm64.*tar\.gz$' ;; \
        *) echo "Unsupported arch: $ARCH" >&2; exit 1 ;; \
      esac; \
      VALE_RELEASE_JSON="$(curl -fsSL https://api.github.com/repos/errata-ai/vale/releases/tags/v${VALE_VERSION})"; \
      VALE_ASSET_NAME="$(printf '%s\n' "$VALE_RELEASE_JSON" | jq -r --arg re "$VALE_ASSET_REGEX" '.assets[] | select(.name | test($re)) | .name')"; \
      VALE_URL="$(printf '%s\n' "$VALE_RELEASE_JSON" | jq -r --arg name "$VALE_ASSET_NAME" '.assets[] | select(.name == $name) | .browser_download_url')"; \
      VALE_CHECKSUM_URL="$(printf '%s\n' "$VALE_RELEASE_JSON" | jq -r '.assets[] | select(.name | test("checksums.txt$")) | .browser_download_url')"; \
      if [ -z "$VALE_URL" ] || [ -z "$VALE_ASSET_NAME" ]; then echo "Unable to locate Vale asset for $ARCH" >&2; exit 1; fi; \
      curl -fsSL "$VALE_URL" -o /tmp/vale.tar.gz; \
      if [ -n "$VALE_CHECKSUM_URL" ]; then \
        curl -fsSL "$VALE_CHECKSUM_URL" -o /tmp/vale.checksums; \
        (cd /tmp && grep "  $VALE_ASSET_NAME" vale.checksums | sha256sum -c -); \
      fi; \
      tar -xzf /tmp/vale.tar.gz -C /usr/local/bin vale; \
      chmod +x /usr/local/bin/vale; \
      rm -f /tmp/vale.tar.gz /tmp/vale.checksums; \
      git lfs install --system; \
      rm -rf /var/lib/apt/lists/*; \
    fi;

FROM toolchain AS runtime-wheels

WORKDIR /tmp/pip

COPY apps/platform/requirements.txt runtime.txt
COPY packages/udocket_core/requirements.txt core.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    mkdir -p /wheels \
 && pip wheel --wheel-dir /wheels wheel \
 && pip wheel --wheel-dir /wheels --requirement runtime.txt \
 && pip wheel --wheel-dir /wheels --requirement core.txt

FROM runtime-wheels AS dev-wheels
ARG DEV_TOOLS

COPY apps/platform/requirements-dev.txt dev.txt
COPY requirements-docs.txt docs.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    if [ "$DEV_TOOLS" = "1" ]; then \
      pip wheel --wheel-dir /wheels --requirement dev.txt; \
      if [ -s docs.txt ]; then \
        pip wheel --wheel-dir /wheels --requirement docs.txt; \
      fi; \
    fi

FROM toolchain AS python-deps
ARG DEV_TOOLS

WORKDIR /app

COPY --from=dev-wheels /wheels /tmp/wheels

# Install Python dependencies (shared across services)
COPY apps/platform/requirements.txt /tmp/platform-requirements.txt
COPY apps/platform/requirements-dev.txt /tmp/platform-requirements-dev.txt
COPY packages/udocket_core/requirements.txt /tmp/udocket-core-requirements.txt
COPY requirements-docs.txt /tmp/requirements-docs.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-index --find-links=/tmp/wheels -r /tmp/platform-requirements.txt \
 && pip install --no-index --find-links=/tmp/wheels -r /tmp/udocket-core-requirements.txt \
 && if [ "$DEV_TOOLS" = "1" ]; then pip install --no-index --find-links=/tmp/wheels -r /tmp/platform-requirements-dev.txt; fi \
 && if [ "$DEV_TOOLS" = "1" ] && [ -s /tmp/requirements-docs.txt ]; then pip install --no-index --find-links=/tmp/wheels -r /tmp/requirements-docs.txt; fi \
 && rm -f /tmp/platform-requirements.txt /tmp/platform-requirements-dev.txt /tmp/udocket-core-requirements.txt \
 && rm -f /tmp/requirements-docs.txt \
 && rm -rf /tmp/wheels

FROM python-deps AS app

WORKDIR /app

# Copy project source last to keep dependency layers hot
COPY . /app

EXPOSE 8000

# Default to prod settings; override in compose if needed
ENV DJANGO_SETTINGS_MODULE=apps.platform.config.settings.prod

COPY infra/docker/entrypoint.platform.sh /usr/local/bin/platform-entrypoint.sh
RUN chmod +x /usr/local/bin/platform-entrypoint.sh

ENTRYPOINT ["platform-entrypoint.sh"]
CMD ["daphne", "-b", "0.0.0.0", "-p", "8000", "apps.platform.config.asgi:application"]
