# syntax=docker/dockerfile:1.7-labs

# Allow overriding the Python base image (useful for mirrors/registries)
ARG PYTHON_BASE=python:3.12-slim-bookworm
ARG DEV_TOOLS=0
ARG BAKE_VENV=1

FROM ${PYTHON_BASE} AS python-base

ARG TARGETARCH
ARG BAKE_VENV

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive
    
# Prepare keyrings/repos once so downstream stages can reuse apt metadata.
RUN --mount=type=cache,id=apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=toolchain-downloads-${TARGETARCH},target=/tmp/cache-downloads,sharing=locked \
    set -eux; \
    install -m 0755 -d /etc/apt/keyrings; \
    cache_dir="/tmp/cache-downloads"; \
    mkdir -p "$cache_dir"; \
    docker_key="$cache_dir/docker.gpg"; \
    gh_key="$cache_dir/gh.gpg"; \
    if [ ! -f "$docker_key" ]; then \
      python -c 'import sys, urllib.request; urllib.request.urlretrieve("https://download.docker.com/linux/debian/gpg", sys.argv[1])' "$docker_key"; \
    fi; \
    cp "$docker_key" /etc/apt/keyrings/docker.asc; \
    chmod a+r /etc/apt/keyrings/docker.asc; \
    if [ ! -f "$gh_key" ]; then \
      python -c 'import sys, urllib.request; urllib.request.urlretrieve("https://cli.github.com/packages/githubcli-archive-keyring.gpg", sys.argv[1])' "$gh_key"; \
    fi; \
    cp "$gh_key" /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
    chmod a+r /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list; \
    apt-get update

# Core packages needed for every image.
RUN --mount=type=cache,id=apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    set -eux; \
    apt-get install -y --no-install-recommends \
      ffmpeg \
      ca-certificates \
      curl \
      git

# Install uv once so downstream stages share the same toolchain.
RUN --mount=type=cache,target=/root/.cache/uv-installer,sharing=locked <<'EOF'
set -eux
cache_dir="/root/.cache/uv-installer"
mkdir -p "$cache_dir"
script="$cache_dir/install.sh"
if [ ! -f "$script" ]; then
  curl -fsSL https://astral.sh/uv/install.sh -o "$script"
fi
UV_INSTALL_DIR=/usr/local/bin sh "$script"
EOF

# Keep pip modern once so every downstream stage benefits. Optionally pre-bake /opt/venv.
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    set -eux; \
    if [ "$BAKE_VENV" = "1" ]; then \
      python -m venv --clear --upgrade-deps /opt/venv; \
      /opt/venv/bin/python -m pip install --upgrade pip setuptools wheel; \
      /opt/venv/bin/python -m pip --version; \
    else \
      python -m pip install --upgrade pip setuptools wheel; \
      python -m pip --version; \
    fi


FROM python-base AS toolchain
ARG TARGETARCH
ARG DEV_TOOLS

# Optional developer tooling (docker CLI, debugging helpers, etc.)
RUN --mount=type=cache,id=apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    if [ "$DEV_TOOLS" = "1" ]; then \
      set -eux; \
      apt-get install -y --no-install-recommends \
        build-essential \
        g++ \
        gcc \
        libpq-dev \
        pkg-config \
        postgresql-client-15; \
    fi;

RUN --mount=type=cache,id=apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    if [ "$DEV_TOOLS" = "1" ]; then \
      set -eux; \
      apt-get install -y --no-install-recommends \
        docker-buildx-plugin \
        docker-ce-cli \
        docker-compose-plugin \
        gh; \
    fi;

RUN --mount=type=cache,id=apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    if [ "$DEV_TOOLS" = "1" ]; then \
      set -eux; \
      apt-get install -y --no-install-recommends \
        git-lfs \
        htop \
        iputils-ping \
        jq \
        less \
        lsof \
        nano \
        netcat-openbsd \
        ripgrep \
        strace \
        tree \
        unzip \
        vim-tiny \
        wget; \
    fi;

RUN if [ "$DEV_TOOLS" = "1" ]; then \
      set -eux; \
      git lfs install --system; \
    fi;

FROM toolchain AS python-deps
ARG DEV_TOOLS
ARG BAKE_VENV

WORKDIR /udocket

# Copy local typewiz code into the container
COPY deps/typewiz /udocket/deps/typewiz

COPY apps/platform/pyproject.toml apps/platform/uv.lock /udocket/apps/platform/

RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    if [ "$BAKE_VENV" = "1" ]; then \
      export UV_PROJECT_ENVIRONMENT=/opt/venv VIRTUAL_ENV=/opt/venv PATH="/opt/venv/bin:${PATH}"; \
      uv sync --frozen --no-dev --no-install-project --project apps/platform; \
    fi; \
    if [ "$DEV_TOOLS" = "1" ]; then \
      # export UV_PROJECT_ENVIRONMENT=.venv VIRTUAL_ENV=.venv PATH=".venv/bin:${PATH}"; \
      uv sync --frozen --only-group dev --no-install-project --project apps/platform; \
    fi;

FROM python-deps AS app

WORKDIR /udocket

# Copy project source last to keep dependency layers hot
COPY . /udocket


ENV UV_PROJECT_ENVIRONMENT=.venv
ENV VIRTUAL_ENV=.venv
# ENV PATH=".venv/bin:${PATH}" 

EXPOSE 8000

# Default to prod settings; override in compose if needed
ENV DJANGO_SETTINGS_MODULE=apps.platform.config.settings.prod

COPY infra/docker/entrypoint.platform.sh /usr/local/bin/platform-entrypoint.sh
RUN chmod +x /usr/local/bin/platform-entrypoint.sh

ENTRYPOINT ["platform-entrypoint.sh"]
CMD ["daphne", "-b", "0.0.0.0", "-p", "8000", "apps.platform.config.asgi:application"]
