# syntax=docker/dockerfile:1.7-labs

# Allow overriding the Python base image (useful for mirrors/registries)
ARG PYTHON_BASE=python:3.12-slim-bookworm
ARG DEV_TOOLS=0
ARG BAKE_VENV=1

FROM ${PYTHON_BASE} AS python-base

ARG TARGETARCH
ARG DEV_TOOLS
ARG BAKE_VENV

ENV PIP_NO_CACHE_DIR=0 \
    PIP_BUILD_PARALLEL=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# Speed up apt by disabling translation index downloads and preferring gzip indexes.
RUN cat > /etc/apt/apt.conf.d/99udocket-fast-apt <<EOF
Acquire::Languages \"none\";
Acquire::CompressionTypes::Order { \"gz\"; };
APT::Get::Assume-Yes \"true\";
EOF
    
# Share helper scripts across images
COPY infra/docker/scripts /usr/local/share/udocket-scripts

# Prepare keyrings/repos and install required APT packages once in the base.
RUN --mount=type=cache,id=udocket-apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=udocket-apt-lists-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,id=toolchain-downloads-${TARGETARCH},target=/tmp/cache-downloads,sharing=locked \
    /usr/local/share/udocket-scripts/setup_apt_repos.sh; \
    set -eux; \
    base_pkgs="ffmpeg ca-certificates curl git"; \
    dev_pkgs="build-essential libpq-dev pkg-config postgresql-client-15 docker-buildx-plugin docker-ce-cli docker-compose-plugin gh git-lfs htop iputils-ping jq less lsof nano netcat-openbsd ripgrep strace tree unzip vim-tiny wget"; \
    if [ "$DEV_TOOLS" = "1" ]; then \
      apt-get install -y --no-install-recommends $base_pkgs $dev_pkgs; \
      git lfs install --system; \
    else \
      apt-get install -y --no-install-recommends $base_pkgs; \
    fi

# Install uv once so downstream stages share the same toolchain.
RUN --mount=type=cache,target=/root/.cache/uv-installer,sharing=locked \
    bash /usr/local/share/udocket-scripts/install_uv.sh

# Keep pip modern once so every downstream stage benefits. Optionally pre-bake /opt/venv.
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    set -eux; \
    if [ "$BAKE_VENV" = "1" ]; then \
      python -m venv --clear --upgrade-deps /opt/venv; \
      /opt/venv/bin/python -m pip install --upgrade pip setuptools wheel; \
      /opt/venv/bin/python -m pip --version; \
    else \
      python -m pip install --upgrade pip setuptools wheel; \
      python -m pip --version; \
    fi


FROM python-base AS toolchain
ARG TARGETARCH
ARG DEV_TOOLS

# All APT work is done in python-base; keep this stage lean.
RUN true

FROM toolchain AS python-deps
ARG DEV_TOOLS
ARG BAKE_VENV

WORKDIR /udocket

# Copy local typewiz code into the container
COPY deps/typewiz /udocket/deps/typewiz

COPY apps/platform/pyproject.toml apps/platform/uv.lock /udocket/apps/platform/

RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    if [ "$BAKE_VENV" = "1" ]; then \
      export UV_PROJECT_ENVIRONMENT=/opt/venv VIRTUAL_ENV=/opt/venv PATH="/opt/venv/bin:${PATH}"; \
      uv sync --frozen --no-dev --no-install-project --project apps/platform; \
      if [ "$DEV_TOOLS" = "1" ]; then \
        export UV_PROJECT_ENVIRONMENT=.venv VIRTUAL_ENV=.venv PATH=".venv/bin:${PATH}"; \
        uv sync --frozen --only-group dev --no-install-project --project apps/platform; \
      fi; \
    fi;

FROM python-deps AS app

WORKDIR /udocket

# Copy project source last to keep dependency layers hot
COPY . /udocket


ENV VIRTUAL_ENV=/opt/venv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

EXPOSE 8000

# Default to prod settings; override in compose if needed
ENV DJANGO_SETTINGS_MODULE=apps.platform.config.settings.prod

COPY infra/docker/entrypoint.platform.sh /usr/local/bin/platform-entrypoint.sh
RUN chmod +x /usr/local/bin/platform-entrypoint.sh

ENTRYPOINT ["platform-entrypoint.sh"]
CMD ["daphne", "-b", "0.0.0.0", "-p", "8000", "apps.platform.config.asgi:application"]
