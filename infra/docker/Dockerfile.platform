FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Optional dev tools (enabled via build-arg DEV_TOOLS=1)
ARG DEV_TOOLS=0
RUN if [ "$DEV_TOOLS" = "1" ]; then \
      apt-get update && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        build-essential \
        curl \
        gcc \
        g++ \
        git \
        git-lfs \
        htop \
        iputils-ping \
        jq \
        less \
        libpq-dev \
        lsof \
        make \
        nano \
        netcat-openbsd \
        postgresql-client \
        pkg-config \
        procps \
        ripgrep \
        sqlite3 \
        strace \
        tcpdump \
        tree \
        unzip \
        vim-tiny \
        wget \
      && git lfs install --system \
      && rm -rf /var/lib/apt/lists/*; \
    fi

WORKDIR /app

# Install platform requirements first for better layer caching
COPY apps/platform/requirements.txt /tmp/requirements.txt
RUN python -m pip install --upgrade pip \
    && pip install -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt

# Copy project
COPY . /app

EXPOSE 8000

# Default to prod settings; override in compose if needed
ENV DJANGO_SETTINGS_MODULE=apps.platform.config.settings.prod

CMD ["sh", "-lc", "python manage.py migrate && python manage.py enable_rls && daphne -b 0.0.0.0 -p 8000 apps.platform.config.asgi:application"]
